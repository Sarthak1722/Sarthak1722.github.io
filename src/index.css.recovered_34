/* UPGRADED PROJECTS AND TIMELINE STYLES */
.c-space {
  @apply sm:px-10 px-5;
}

.head-text {
  @apply sm:text-4xl text-3xl font-semibold bg-gradient-to-r from-[#BEC1CF] to-[#D5D8EA] bg-clip-text text-transparent;
}

.arrow-btn {
  @apply w-10 h-10 p-3 cursor-pointer active:scale-95 transition-all rounded-full;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,0.1);
  background-image: linear-gradient(
    to right,
    rgba(255, 255, 255, 0.1) 10%,
    rgba(255, 255, 255, 0.000025) 50%,
    rgba(255, 255, 255, 0.000025) 50%,
    rgba(255, 255, 255, 0.025) 100%
  );
}

.arrow-gradient {
  background-image: linear-gradient(
    to right,
    rgba(255, 255, 255, 0.1) 10%,
    rgba(255, 255, 255, 0.000025) 50%,
    rgba(255, 255, 255, 0.000025) 50%,
    rgba(255, 255, 255, 0.025) 100%
  );
}

.tech-logo {
  @apply w-10 h-10 rounded-md p-2 bg-neutral-100/10 backdrop-blur-lg flex justify-center items-center;
}

.tech-logo img {
  @apply w-full h-full object-contain;
}

.hash-span {
  margin-top: -100px;
  padding-bottom: 100px;
  display: block;
}

/* Canvas Loader Spinner */
.canvas-loader {
  font-size: 10px;
  width: 1em;
  height: 1em;
  border-radius: 50%;
  position: relative;
  text-indent: -9999em;
  animation: mulShdSpin 1.1s infinite ease;
  transform: translateZ(0);
  display: inline-block;
}

